# Groq API (free tier)
GROQ_API_KEY=your-groq-api-key

# Twitter / X API v2 (OAuth 2.0 User Context with PKCE)
# Get Client ID and Secret from https://developer.x.com/en/portal/dashboard
TWITTER_CLIENT_ID=your-client-id
TWITTER_CLIENT_SECRET=your-client-secret
# Run `python3 authorize.py` to obtain these tokens:
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_REFRESH_TOKEN=your-refresh-token

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
TWEET_TIMES=08:00,11:00,14:00,17:00,20:00
HISTORY_SIZE=100
